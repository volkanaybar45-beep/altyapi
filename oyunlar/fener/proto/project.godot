; Fener Bekçisi — Prototip (ayna çevir, ışığı tekneye ulaştır)

config_version=5

[application]

config/name="Fener Bekçisi"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

; EN sütunu ceviri.csv'de BOŞ (Tasarım yazacak). Boş EN yüklenirse İngilizce
; cihazda metinler boş çıkabilir; o yüzden EN dolana kadar sadece TR bağlı.
locale/translations=PackedStringArray("res://metin/ceviri.tr.translation")
locale/fallback="tr"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.1, 1)
